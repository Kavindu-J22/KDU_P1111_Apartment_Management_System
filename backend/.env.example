# Copy this to .env and fill in your cloud DB values

PORT=5000

# Cloud MySQL (Railway / TiDB / PlanetScale)
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=3306

# JWT — use a long random string in production
JWT_SECRET=replace_with_strong_random_secret_min_32chars

# Email (Nodemailer)
EMAIL_USER=apartmentmanagementsystem123@gmail.com
EMAIL_PASS=your_app_password

# Set to your Vercel frontend URL (used for CORS)
FRONTEND_URL=https://your-app.vercel.app
